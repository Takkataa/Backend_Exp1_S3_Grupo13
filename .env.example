# Copie este archivo como ".env" y complete los valores:   cp .env.example .env
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# --- Base de datos ---
DB_NAME=petsalud_db
DB_USER=petsalud
DB_PASSWORD=CambiarEstaClave123
DB_ROOT_PASSWORD=CambiarEstaClaveRoot123
# Puerto de tu equipo para conectarte a MySQL desde fuera (DBeaver, Workbench, etc.)
DB_HOST_PORT=3307

# --- Aplicacion ---
APP_PORT=8080

# Clave para firmar los tokens JWT (Base64, minimo 32 bytes). Generar con:
#   openssl rand -base64 64
JWT_SECRET=PEGAR_AQUI_LA_CLAVE_GENERADA

# --- Primer administrador (gerente), se crea automaticamente al arrancar ---
ADMIN_EMAIL=admin@petsalud.cl
ADMIN_PASSWORD=CambiarAdmin123!
